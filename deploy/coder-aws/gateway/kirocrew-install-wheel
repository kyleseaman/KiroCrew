#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ] || [ "$#" -ne 3 ]; then
  printf 'Usage (as root): %s <wheel> <sha256> <dashboard-url-base64>\n' "$0" >&2
  exit 2
fi

wheel=$1
expected_sha=$2
dashboard_url_b64=$3

case "$expected_sha" in
  *[!0-9a-f]*|'') printf 'Invalid SHA-256 value\n' >&2; exit 2 ;;
esac
[ "${#expected_sha}" -eq 64 ] || {
  printf 'Invalid SHA-256 length\n' >&2
  exit 2
}
wheel_name=${wheel##*/}
remote_dir=${wheel%/*}
case "$wheel_name" in
  kirocrew-*-py3-none-any.whl) ;;
  *) printf 'Refusing unexpected wheel name: %s\n' "$wheel_name" >&2; exit 2 ;;
esac
printf '%s\n' "$remote_dir" \
  | /usr/bin/grep -Eq '^/tmp/kirocrew-deploy\.[A-Za-z0-9]{8}$' || {
    printf 'Refusing unexpected staging directory: %s\n' "$remote_dir" >&2
    exit 2
  }
[ "$wheel" = "$remote_dir/$wheel_name" ] && [ -f "$wheel" ] && [ ! -L "$wheel" ] || {
  printf 'Refusing unexpected wheel path: %s\n' "$wheel" >&2
  exit 2
}

dashboard_url=$(printf '%s' "$dashboard_url_b64" | /usr/bin/base64 --decode)
printf '%s\n' "$dashboard_url" \
  | /usr/bin/grep -Eq '^https://[A-Za-z0-9._-]+(:[0-9]{1,5})?/?$' || {
    printf 'Invalid dashboard URL\n' >&2
    exit 2
  }

staging_root=/var/lib/kirocrew-staging
/usr/bin/install -d -m 0755 -o root -g root "$staging_root"
verified_dir=$(/usr/bin/mktemp -d /var/lib/kirocrew-staging/install.XXXXXXXXXX)
/usr/bin/chmod 0755 "$verified_dir"
verified_wheel=$verified_dir/$wheel_name
cleanup_verified() {
  /usr/bin/rm -f -- "$verified_wheel"
  /usr/bin/rmdir -- "$verified_dir" 2>/dev/null || true
}
trap cleanup_verified 0
/usr/bin/install -m 0644 -o root -g root "$wheel" "$verified_wheel"
printf '%s  %s\n' "$expected_sha" "$verified_wheel" \
  | /usr/bin/sha256sum --check --status

/usr/sbin/runuser -u coder -- env \
  HOME=/home/coder USER=coder LOGNAME=coder \
  /usr/bin/python3.11 -m venv /home/coder/kirocrew-venv
/usr/sbin/runuser -u coder -- env \
  HOME=/home/coder USER=coder LOGNAME=coder \
  /home/coder/kirocrew-venv/bin/pip install --upgrade "$verified_wheel"
/usr/sbin/runuser -u coder -- env \
  HOME=/home/coder USER=coder LOGNAME=coder \
  /home/coder/kirocrew-venv/bin/pip install --force-reinstall --no-deps "$verified_wheel"
/usr/sbin/runuser -u coder -- env \
  HOME=/home/coder USER=coder LOGNAME=coder \
  /bin/sh -c 'cd /home/coder && exec /home/coder/kirocrew-venv/bin/kirocrew setup --agent-only'
# The inner shell expands $1 from the positional argument passed below.
# shellcheck disable=SC2016
/usr/sbin/runuser -u coder -- env \
  HOME=/home/coder USER=coder LOGNAME=coder \
  /bin/sh -c 'cd /home/coder && exec /home/coder/kirocrew-venv/bin/kirocrew config set dashboard.url "$1"' \
  sh "$dashboard_url"

# Kiro Crew's rootless cgroup scopes use the coder systemd user manager. Keep
# that manager alive across web-terminal and SSH disconnects so agent process
# and memory ceilings remain enforceable on this 24/7 gateway.
/usr/bin/loginctl enable-linger coder

# The sample gateway intentionally starts at 2 GiB. Its local embedding model
# and a warm Kiro runtime can briefly consume most of that, so provide bounded
# disk-backed headroom rather than letting a transient peak freeze the host.
# Agent scopes still carry MemorySwapMax=0; this swap protects the gateway and
# operating system, not untrusted agent trees.
swap_file=/var/lib/kirocrew/swapfile
/usr/bin/install -d -m 0700 /var/lib/kirocrew
if [ ! -f "$swap_file" ]; then
  /usr/bin/fallocate -l 2G "$swap_file"
  /usr/bin/chmod 0600 "$swap_file"
  /usr/sbin/mkswap "$swap_file" >/dev/null
fi
if ! /usr/bin/grep -Fq "$swap_file none swap defaults,nofail 0 0" /etc/fstab; then
  printf '%s none swap defaults,nofail 0 0\n' "$swap_file" >> /etc/fstab
fi
if ! /usr/sbin/swapon --show=NAME --noheadings | /usr/bin/grep -Fxq "$swap_file"; then
  /usr/sbin/swapon "$swap_file"
fi

env SUDO_USER=coder USER=coder LOGNAME=coder HOME=/home/coder KIROCREW_PORT=8443 \
  KIROCREW_SERVICE_BIN=/home/coder/kirocrew-venv/bin/kirocrew \
  /home/coder/kirocrew-venv/bin/kirocrew service install

attempt=0
until /usr/bin/systemctl is-active --quiet kirocrew.service \
  && /usr/bin/curl --fail --silent --show-error \
    http://127.0.0.1:8443/api/health >/dev/null; do
  attempt=$((attempt + 1))
  if [ "$attempt" -ge 30 ]; then
    /usr/bin/journalctl -u kirocrew.service --no-pager -n 80 >&2 || true
    exit 1
  fi
  sleep 1
done

/usr/bin/rm -f -- "$wheel"
cleanup_verified
trap - 0
printf 'Installed verified Kiro Crew wheel and restarted the gateway.\n'
