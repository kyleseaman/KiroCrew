#!/usr/bin/env bash
set -euo pipefail
umask 077

BOOTSTRAP_STATUS="/var/lib/kirocrew/bootstrap-status"
install -d -m 0755 /var/lib/kirocrew
write_bootstrap_status() {
  printf '%s\n' "$1" > "$BOOTSTRAP_STATUS"
  chmod 0644 "$BOOTSTRAP_STATUS"
}
BOOTSTRAP_STAGE="packages"
trap 'status=$?; write_bootstrap_status "failed:$BOOTSTRAP_STAGE"; exit "$status"' ERR
write_bootstrap_status "running:$BOOTSTRAP_STAGE"

curl_retry() {
  /usr/bin/curl --retry 5 --retry-all-errors --connect-timeout 10 --max-time 120 "$@"
}

dnf install -y \
  ca-certificates \
  dnf-plugins-core \
  git \
  jq \
  nodejs22 \
  nodejs22-npm \
  python3.11 \
  python3.11-pip \
  unzip

CODER_RPM="coder_${coder_version}_linux_arm64.rpm"
curl_retry --proto '=https' --tlsv1.2 -fsSL \
  "https://github.com/coder/coder/releases/download/v${coder_version}/$CODER_RPM" \
  -o "/var/tmp/$CODER_RPM"
printf '%s  %s\n' "${coder_rpm_sha256}" "/var/tmp/$CODER_RPM" | sha256sum -c -
dnf install -y "/var/tmp/$CODER_RPM"
rm -f "/var/tmp/$CODER_RPM"

dnf config-manager --add-repo \
  https://pkgs.tailscale.com/stable/amazon-linux/2023/tailscale.repo
dnf install -y tailscale
systemctl enable --now tailscaled

TAILSCALE_KEY_FILE="$(mktemp /run/tailscale-auth.XXXXXXXXXX)"
trap 'rm -f "$TAILSCALE_KEY_FILE"' EXIT
aws ssm get-parameter \
  --region "${region}" \
  --name "${tailscale_auth_parameter}" \
  --with-decryption \
  --query Parameter.Value \
  --output text > "$TAILSCALE_KEY_FILE"
tailscale up \
  --auth-key="file:$TAILSCALE_KEY_FILE" \
  --hostname="${tailscale_gateway_hostname}" \
  --ssh \
  --accept-dns=true
rm -f "$TAILSCALE_KEY_FILE"
trap - EXIT

id coder >/dev/null 2>&1 || useradd --create-home --shell /bin/bash coder
# The Coder RPM creates a non-login service account before this template runs.
# Gateway workspaces expose Coder's web terminal, so normalize that existing
# account to the same interactive shell used by session workspaces.
usermod --shell /bin/bash coder
install -d -o coder -g coder /home/coder/.config/coderv2 /home/coder/.cache/coder
install -d -o coder -g coder -m 0700 /home/coder/.kiro
install -d -o coder -g coder -m 0700 /home/coder/.kiro/crew

KIRO_API_KEY="$(aws ssm get-parameter \
  --region "${region}" \
  --name "${kiro_api_key_parameter}" \
  --with-decryption \
  --query Parameter.Value \
  --output text)"
printf 'KIRO_API_KEY=%s\n' "$KIRO_API_KEY" > /home/coder/.kiro/crew/.env
unset KIRO_API_KEY
chown coder:coder /home/coder/.kiro/crew/.env
chmod 0600 /home/coder/.kiro/crew/.env

base64 --decode > /usr/local/bin/kirocrew <<'EOF'
${kirocrew_admin_launcher_b64}
EOF
chown root:root /usr/local/bin/kirocrew
chmod 0755 /usr/local/bin/kirocrew
base64 --decode > /usr/local/sbin/kirocrew-install-wheel <<'EOF'
${kirocrew_wheel_installer_b64}
EOF
chown root:root /usr/local/sbin/kirocrew-install-wheel
chmod 0755 /usr/local/sbin/kirocrew-install-wheel

# Amazon Linux mounts /tmp as a RAM-backed filesystem sized from the instance.
# Keep the verified archive and extraction on the persistent root disk so the
# t4g.small gateway does not need to be upsized merely to bootstrap.
KIRO_BOOTSTRAP_DIR="/var/tmp/kirocrew-bootstrap"
install -d -m 0700 "$KIRO_BOOTSTRAP_DIR"

# Amazon Linux 2023 needs the static musl aarch64 Kiro CLI package.
BOOTSTRAP_STAGE="kiro-cli"
write_bootstrap_status "running:$BOOTSTRAP_STAGE"
curl_retry --proto '=https' --tlsv1.2 -fsSL \
  https://desktop-release.q.us-east-1.amazonaws.com/latest/manifest.json \
  -o "$KIRO_BOOTSTRAP_DIR/manifest.json"
readarray -t KIRO_PACKAGE < <(python3 - <<'PY'
import json

with open("/var/tmp/kirocrew-bootstrap/manifest.json", encoding="utf-8") as handle:
    manifest = json.load(handle)
package = next(
    package
    for package in manifest["packages"]
    if package["fileType"] == "zip"
    and package["architecture"] == "aarch64"
    and "musl" in package["download"]
)
print(package["download"])
print(package["sha256"])
PY
)
curl_retry --proto '=https' --tlsv1.2 -fsSL \
  "https://desktop-release.q.us-east-1.amazonaws.com/$${KIRO_PACKAGE[0]}" \
  -o "$KIRO_BOOTSTRAP_DIR/kirocli.zip"
printf '%s  %s\n' "$${KIRO_PACKAGE[1]}" "$KIRO_BOOTSTRAP_DIR/kirocli.zip" \
  | sha256sum -c -
unzip -q "$KIRO_BOOTSTRAP_DIR/kirocli.zip" -d "$KIRO_BOOTSTRAP_DIR"
Q_INSTALL_GLOBAL=1 Q_SKIP_SETUP=1 "$KIRO_BOOTSTRAP_DIR/kirocli/install.sh"
rm -rf "$KIRO_BOOTSTRAP_DIR"
kiro-cli --version

printf '%s' '${coder_init_script_b64}' | base64 -d > /usr/local/libexec/coder-agent-init
chmod 700 /usr/local/libexec/coder-agent-init
chown coder:coder /usr/local/libexec/coder-agent-init

cat > /etc/systemd/system/coder-agent.service <<'EOF'
[Unit]
Description=Coder gateway workspace agent
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=coder
Group=coder
Environment=HOME=/home/coder
WorkingDirectory=/home/coder
ExecStart=/usr/local/libexec/coder-agent-init
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now coder-agent.service
tailscale serve --bg --https=8443 http://127.0.0.1:8443
trap - ERR
write_bootstrap_status "complete"
