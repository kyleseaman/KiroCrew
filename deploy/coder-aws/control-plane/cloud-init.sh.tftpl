#!/usr/bin/env bash
set -euo pipefail
umask 077

dnf install -y \
  ca-certificates \
  dnf-plugins-core
dnf config-manager --add-repo \
  https://pkgs.tailscale.com/stable/amazon-linux/2023/tailscale.repo
dnf install -y tailscale
systemctl enable --now tailscaled

TAILSCALE_KEY_FILE="$(mktemp /run/tailscale-auth.XXXXXXXXXX)"
trap 'rm -f "$TAILSCALE_KEY_FILE"' EXIT
aws ssm get-parameter \
  --region "${region}" \
  --name "${tailscale_auth_parameter}" \
  --with-decryption \
  --query Parameter.Value \
  --output text > "$TAILSCALE_KEY_FILE"
tailscale up \
  --auth-key="file:$TAILSCALE_KEY_FILE" \
  --hostname="${tailscale_hostname}" \
  --ssh \
  --accept-dns=false
rm -f "$TAILSCALE_KEY_FILE"
trap - EXIT

CODER_RPM="coder_${coder_version}_linux_arm64.rpm"
curl --proto '=https' --tlsv1.2 -fsSL \
  "https://github.com/coder/coder/releases/download/v${coder_version}/$CODER_RPM" \
  -o "/tmp/$CODER_RPM"
printf '%s  %s\n' "${coder_rpm_sha256}" "/tmp/$CODER_RPM" | sha256sum -c -
dnf install -y "/tmp/$CODER_RPM"
rm -f "/tmp/$CODER_RPM"

id coder >/dev/null 2>&1 || useradd --create-home --shell /bin/bash coder
install -d -o coder -g coder /home/coder/.config/coderv2 /home/coder/.cache/coder
install -d -m 0755 /etc/coder.d
cat > /etc/coder.d/coder.env <<'EOF'
CODER_ACCESS_URL=https://${tailscale_hostname}.${tailnet_dns_name}
CODER_HTTP_ADDRESS=127.0.0.1:3000
CODER_TELEMETRY_ENABLE=false
CODER_UPDATE_CHECK=false
CODER_CACHE_DIRECTORY=/home/coder/.cache/coder
CODER_MAX_ADMIN_TOKEN_LIFETIME=8760h
EOF

cat > /etc/systemd/system/coder-poc.service <<'EOF'
[Unit]
Description=Coder single-user POC
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=coder
Group=coder
Environment=HOME=/home/coder
EnvironmentFile=/etc/coder.d/coder.env
ExecStart=/usr/bin/coder server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now coder-poc.service

tailscale serve --bg --https=443 http://127.0.0.1:3000
